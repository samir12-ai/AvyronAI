{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "expo:dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5000 npx expo start --localhost",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/migrations/runner.ts",
    "start": "npx expo start",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "lifecycle:test": "vitest run server/tests/lifecycle/",
    "lifecycle:flake": "bash scripts/lifecycle-flake-check.sh",
    "replay:run": "tsx scripts/replay-cli.ts run",
    "replay:list": "tsx scripts/replay-cli.ts list",
    "replay:capture-synthetic": "tsx scripts/replay-cli.ts capture-synthetic",
    "replay:test": "vitest run server/tests/orchestrator-replay/",
    "replay:flake": "bash scripts/replay-flake-check.sh",
    "lint:vocab": "bash scripts/check-engine-vocabulary.sh",
    "lint:fallback-strings": "bash scripts/check-banned-fallback-strings.sh",
    "lint:all": "npm run lint && npm run lint:vocab && npm run lint:fallback-strings"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
