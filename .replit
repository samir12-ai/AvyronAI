entrypoint = "README.md"
modules = ["nodejs-22", "python-3.11", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["ffmpeg", "chromium"]

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm run expo:static:build && node scripts/server-build.js"]
run = ["sh", "-c", "PORT=8081 npm run server:prod"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5099
externalPort = 3003

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8083
externalPort = 3000

[[ports]]
localPort = 8084
externalPort = 3001

[[ports]]
localPort = 8091
externalPort = 4200

[env]
PORT = "5000"

[agent]
stack = "EXPO"
integrations = ["javascript_openai_ai_integrations:2.0.0", "javascript_gemini_ai_integrations:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Audit Runner"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Phase A Validation"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run server:dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run expo:dev"
waitForPort = 8081

[[workflows.workflow]]
name = "Audit Runner"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "SYNTHETIC_AUDIT_MODE=1 ENGINE_TIMEOUT_MS_OVERRIDE=420000 COMMERCIAL_REASONER_ENABLED=1 COMMERCIAL_REASONER_ALLOWED_INDUSTRIES=b2b_saas,dtc_ecom,local_services npx tsx .local/scripts/run-audit-pipelines.ts && npx tsx .local/scripts/judge-engine-outputs.ts --out .local/validation/judge-scores__treatment_v4.json && npx tsx .local/scripts/compare-control-vs-treatment.ts --control .local/validation/judge-scores__control.json --treatment .local/validation/judge-scores__treatment_v4.json > .local/validation/compare-output-v4.md && echo '=== V4 AUDIT COMPLETE ==='"

[[workflows.workflow]]
name = "Phase A Validation"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "SYNTHETIC_AUDIT_MODE=1 ENGINE_TIMEOUT_MS_OVERRIDE=420000 COMMERCIAL_REASONER_ENABLED=1 COMMERCIAL_REASONER_ALLOWED_INDUSTRIES=b2b_saas,dtc_ecom,local_services npx tsx .local/scripts/run-audit-pipelines.ts b2b_saas"

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]
BRIGHT_DATA_COUNTRY = "ae"

[userenv.production]
PUBLIC_BASE_URL = "https://avyronai.com"
ALLOWED_PUBLIC_HOSTS = "avyronai.com"
BOOT_AUTO_MIGRATE = "true"

[userenv.development]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
